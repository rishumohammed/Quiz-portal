# Core
PORT=5002
NODE_ENV=development
APP_URL=http://localhost:5002
FRONTEND_URL=http://localhost:3000

# Database (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
