# JWT
JWT_ACCESS_SECRET=kefta_talent_hunt_access_secret_link_123_change_me
JWT_REFRESH_SECRET=kefta_talent_hunt_refresh_secret_link_456_change_me
JWT_ACCESS_EXPIRY=24h
JWT_REFRESH_EXPIRY=7d

# Resend REST API (HTTPS Port 443)
RESEND_API_KEY=
